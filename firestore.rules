rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMessageSoftDelete() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['deletedAt'])
        && request.resource.data.deletedAt is timestamp;
    }

    function isMessageEditWithinWindow() {
      return request.time < resource.data.sentAt + duration.value(1, 'h')
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.editedAt is timestamp;
    }

    match /visitors/{visitorId} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /ai_matches/{document} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /dev_matches/{document} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /brulias_clicks/{document} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    match /analytics_events/{document} {
      allow read, delete: if request.auth != null;
      allow create: if true;
    }

    // Chat — visitante cria/atualiza conversa e mensagens; admin tem acesso total
    match /chat_conversations/{conversationId} {
      allow create, update: if true;
      allow read: if true;
      allow delete: if request.auth != null;

      match /messages/{messageId} {
        allow create: if true;
        allow read: if true;
        allow update: if isMessageSoftDelete() || isMessageEditWithinWindow();
        allow delete: if request.auth != null;

        match /edits/{editId} {
          allow create: if request.time < get(/databases/$(database)/documents/chat_conversations/$(conversationId)/messages/$(messageId)).data.sentAt + duration.value(1, 'h');
          allow read: if request.auth != null;
          allow delete: if request.auth != null;
        }
      }
    }

    // Token FCM do admin — só admin lê/escreve
    match /admin_config/{docId} {
      allow read, write: if request.auth != null;
    }

    // Presença do owner — qualquer um lê; só autenticado escreve
    match /presence/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
