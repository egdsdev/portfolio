rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Arquivos de chat — qualquer um pode enviar, qualquer um pode ler (link direto)
    match /chat_files/{convId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }
  }
}
